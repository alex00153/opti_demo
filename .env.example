# LLM 配置模板
# 用法：复制本文件为 .env 并填写你自己的配置（.env 属于本机配置，不要放进发布包）。
# 取值优先级：.env > 环境变量 > ~/.claude/settings.json

# ---- 后端选择 --------------------------------------------------------------
# claude-cli（默认）  走本机 `claude -p`，开箱可用；下面三项都必须填
# custom              不内置客户端 —— 请自己在 llm_agent.py 的
#                     call_llm_custom() 里实现你的调用，下面三项可当输入直接用
#
# demo 只把闭环脚手架搭好，"接哪个模型"是留给你的练习。
LLM_BACKEND=claude-cli

# ---- 以下三项在 claude-cli 后端下必填 --------------------------------------

# API Key
LLM_API_KEY=sk-your-api-key

# 端点（Anthropic 兼容格式）：claude CLI 会自行追加 /v1/messages
# 示例为 DeepSeek 官方 Anthropic 端点
LLM_BASE_URL=https://api.deepseek.com/anthropic

# 模型名（DeepSeek 官方：deepseek-chat / deepseek-reasoner）
# 留空则交给 claude CLI 用它自己的默认模型
LLM_MODEL=deepseek-chat
